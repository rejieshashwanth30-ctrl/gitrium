# ADYK Gitrium Environment Variables Template
# Copy this file to .env.local when ready for production backend integration.
# Do NOT commit real secret values to source control.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth (for Email / Password authentication)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Neon Auth Endpoints
NEON_AUTH_URL=https://<neon-endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<neon-endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon PostgreSQL & Prisma ORM
DATABASE_URL="postgresql://<user>:<password>@<neon-endpoint>.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://<user>:<password>@<neon-endpoint>.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Server-Side Token Encryption (AES-256-GCM)
ENCRYPTION_KEY="32_character_or_seed_string_for_vault_encryption"

# GitHub OAuth App Configuration
# Note: In GitHub Developer Settings -> OAuth Apps:
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: https://<neon-endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/callback/github
# Client ID is 20 characters (starts with Ov23... or 20 hex chars)
GITHUB_CLIENT_ID=
# Client Secret is 40 hex characters
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# AI Provider Key
AI_PROVIDER_API_KEY=
